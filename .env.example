# Copy to .env and export, or set these in your shell. All are optional in local mode.

# "local" (default) or "aws"
RAG_BACKEND=local

# Model ID. Defaults: claude-opus-5-5 (local), anthropic.claude-opus-5-5 (aws)
# RAG_MODEL=
# low | medium | high | xhigh | max
RAG_EFFORT=medium
# Passages returned per search
RAG_TOP_K=4
# Messages of history replayed per request
RAG_MAX_HISTORY=20
# Where the local vector store is kept
RAG_DATA_DIR=.data

# --- aws backend only (set by the CDK stack on the deployed services) ---
# AWS_REGION=eu-west-1
# OPENSEARCH_ENDPOINT=
# OPENSEARCH_INDEX=documents
# HISTORY_TABLE=
# RAG_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# RAG_EMBEDDING_DIM=1024

# Model credentials are never stored in this file's values by the project.
# Local mode reads ANTHROPIC_API_KEY (or an `ant auth login` profile) from
# your environment; aws mode uses the task's IAM role.
